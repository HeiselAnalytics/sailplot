{
  "name": "@heiselanalytics/sailplot",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist-package/sailplot.js",
  "module": "./dist-package/sailplot.js",
  "types": "./dist-package/types/package-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist-package/types/package-entry.d.ts",
      "import": "./dist-package/sailplot.js"
    },
    "./styles.css": "./dist-package/sailplot.css",
    "./assets/*": "./dist-package/assets/*",
    "./icons/*": "./dist-package/icons/*"
  },
  "sideEffects": [
    "./dist-package/sailplot.css"
  ],
  "files": [
    "dist-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "vite build --config vite.package.config.ts && tsc -p tsconfig.package.json",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "dexie": "^4.0.11",
    "jspdf": "^4.2.1",
    "konva": "^9.3.18",
    "lucide-react": "^0.468.0",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "react-konva": "^18.2.10",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/pako": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
